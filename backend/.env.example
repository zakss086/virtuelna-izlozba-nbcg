# Copy to backend/.env and adjust. Every variable has a working default for local development.

# SQLite (default, zero setup) or Postgres (after `docker compose up -d db` from the repo root):
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-before-sharing
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uploaded media: folder and size limit per file (MB)
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=50

# Public address of the site (sitemap, share previews) and the built frontend folder
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_DIST_DIR=../frontend/dist

# Browser origins allowed to call the API, JSON list
ALLOWED_ORIGINS=["http://localhost:5173"]
